[Unit]
Description=Retry the Bluetooth factory address until the controller accepts it
Documentation=https://github.com/minghao680/equuleus-mainline/blob/main/docs/STATUS.md

[Timer]
# First attempt well after the controller has settled, then keep trying. The
# helper exits 0 whether or not it succeeded, so the timer always comes back.
OnBootSec=10min
OnUnitActiveSec=10min
AccuracySec=1min
Unit=bluetooth-addr.service
Persistent=false

[Install]
WantedBy=timers.target