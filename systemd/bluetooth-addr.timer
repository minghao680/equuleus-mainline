[Unit]
Description=Retry the Bluetooth factory address until the controller accepts it
Documentation=https://github.com/minghao680/equuleus-mainline/blob/main/docs/bluetooth-handoff.md

[Timer]
# Readiness measured anywhere from ~2 min to ~13 min after boot, so tick often
# enough to converge quickly, but never retry inside one invocation: a loop keeps
# the controller from finishing setup, a single attempt after a pause succeeds.
OnBootSec=2min
OnUnitActiveSec=3min
AccuracySec=30s
Unit=bluetooth-addr.service
Persistent=false

[Install]
WantedBy=timers.target