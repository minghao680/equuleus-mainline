[Unit]
Description=Activate the modem's primary UIM session
Documentation=https://github.com/minghao680/equuleus-mainline/blob/main/docs/sim-sms-handoff.md
# ModemManager cannot initialise the modem until a primary GW provisioning
# session exists ("GW primary session index unknown"), and the modem never
# creates one by itself. This unit creates it first, then lets ModemManager
# probe a modem that already has a usable SIM session.
After=rmtfs.service qrtr-ns.service
Before=ModemManager.service
Wants=rmtfs.service qrtr-ns.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/modem-bringup.sh
# The helper waits up to 2 min for QMI, then does a handful of bounded calls.
TimeoutStartSec=220

[Install]
WantedBy=multi-user.target