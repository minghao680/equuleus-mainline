[Unit]
Description=Apply the factory Wi-Fi MAC address
After=local-fs.target rmtfs.service
Before=network-pre.target NetworkManager.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wifi-mac.sh
RemainAfterExit=yes
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target NetworkManager.service
