[Unit]
Description=Set the Bluetooth controller's factory address
Documentation=https://github.com/minghao680/equuleus-mainline/blob/main/docs/bluetooth-handoff.md
# Single owner for the controller address. bluetooth.service pulls this in with
# Wants=/After= (see the drop-in), so the daemon never starts before an address
# exists and this unit never drives the daemon itself.
#
# Readiness is decided by the management interface, not by elapsed time: an
# HCI_UNCONFIGURED controller does not appear in `btmgmt info`, but it does
# appear in `btmgmt unconf-index`, which the helper polls read-only.
After=local-fs.target
Before=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bluetooth-addr.sh
# The helper waits up to a minute for hci0 and two for the mgmt interface, then
# makes one bounded write.
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target