[Unit]
Description=Set the Bluetooth controller's factory address
Documentation=https://github.com/minghao680/equuleus-mainline/blob/main/docs/STATUS.md
# The WCN3990 comes up as HCI_UNCONFIGURED because hci_qca marks its address
# invalid, so every normal open is refused until userspace supplies one:
#
#   hciconfig hci0 up    -> Operation not supported (95)
#   bluetoothctl show    -> No default controller available
#
# btmgmt only accepts the address many minutes after hci0 appears, and a loop
# that retries every few seconds keeps the controller from ever getting there:
# such a loop failed for 900-1000 s on real boots, while a single attempt after a
# quiet period returned "complete" immediately. This unit therefore makes one
# attempt per invocation and bluetooth-addr.timer invokes it again every ten
# minutes. Nothing here is ordered before the boot, so it can never delay it.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/bluetooth-addr.sh
# One btmgmt call plus the power-on retries, nothing long-running.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target