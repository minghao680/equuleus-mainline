[Unit]
Description=Set the Bluetooth controller's factory address
Documentation=https://github.com/minghao680/equuleus-mainline/blob/main/docs/STATUS.md
# The WCN3990 comes up as HCI_UNCONFIGURED because hci_qca marks its address invalid,
# and the kernel only lets such a controller be configured through the management
# interface. Until an address is supplied, every normal open is refused:
#
#   hciconfig hci0 up    -> Operation not supported (95)
#   bluetoothctl show    -> No default controller available
#
# So this must run, and finish, before bluetooth.service tries to bring it up.
# btmgmt's management socket conflicts with bluetoothd's, which is another reason for
# the ordering.
After=local-fs.target
Before=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bluetooth-addr.sh
# The script bounds each btmgmt call, but bound the unit too so a stuck controller can
# never hold up boot.
TimeoutStartSec=40

[Install]
WantedBy=multi-user.target